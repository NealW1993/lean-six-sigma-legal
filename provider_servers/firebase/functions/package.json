{
  "name": "lean-six-sigma-firebase-provider",
  "private": true,
  "main": "lib/index.js",
  "engines": {"node": "22"},
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "deploy": "npm run build && firebase deploy --only functions,firestore:rules,storage"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@google-cloud/storage": "$@google-cloud/storage",
    "gaxios": "8.0.0",
    "uuid": "14.0.2"
  }
}
